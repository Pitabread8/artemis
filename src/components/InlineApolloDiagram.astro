---
import { rockets, renderRocketSvg, contractorKey, apolloParts, getRocketPriceTotal, formatPriceTotal, minPriceLabel, maxPriceLabel } from '../lib/rocket';

const apolloRocket = rockets.find((r) => r.slug === 'apollo')!;
const slide = { label: apolloRocket.label, svg: renderRocketSvg(apolloRocket) };
const apolloTotal = formatPriceTotal(getRocketPriceTotal(apolloRocket.parts));

const apolloContractors = new Set(Object.values(apolloParts).map((p) => p.contractor));
const apolloContractorKey = contractorKey
  .map((item) => ({
    ...item,
    children: item.children.filter((child) => apolloContractors.has(child.name)),
  }))
  .filter((item) => apolloContractors.has(item.name) || item.children.length > 0);
---

<style is:global>
  .inline-diagram--apollo { min-height: 660px; }

  .inline-diagram--apollo .panel {
    width: 188px;
    padding: 0 6px 74px 0;
    transform: translateX(calc(-50% - 210px));
  }

  .inline-diagram--apollo .mode-toggle {
    position: absolute;
    left: 50%;
    bottom: 66px;
    transform: translateX(118px);
    width: auto;
  }

  .inline-diagram--apollo .mode-button { padding: 6px 11px; font-size: 0.66rem; }
  .inline-diagram--apollo .key-row { font-size: 0.72rem; }
  .inline-diagram--apollo .rocket-svg { width: min(100%, 360px); height: 640px; }

  @media (max-width: 780px) {
    .inline-diagram--apollo .mode-toggle {
      position: static;
      transform: none;
      justify-self: start;
      margin-top: 4px;
    }

    .inline-diagram--apollo .rocket-svg { height: auto; }
  }
</style>

<section
  class="inline-diagram inline-diagram--apollo diagram-panel"
  data-diagram-panel
  data-initial-mode="contractors"
  data-inline-price-simple="true"
  aria-label="Apollo Saturn V contractor and price diagram"
>
  <aside class="panel" aria-label="Apollo Saturn V contractor key">
    <section class="price-legend" aria-labelledby="inline-apollo-price-title">
      <h2 id="inline-apollo-price-title">Price Scale</h2>
      <div class="price-gradient" aria-hidden="true"></div>
      <div class="price-scale">
        <span>min: {minPriceLabel}</span>
        <span>max: {maxPriceLabel}</span>
      </div>
      <p class="price-total">
        Total shown
        <strong>{apolloTotal}</strong>
      </p>
    </section>

    <section class="key contractor-key" aria-labelledby="inline-apollo-contractor-title">
      <h2 id="inline-apollo-contractor-title">Key</h2>
      {
        apolloContractorKey.map((item) => (
          <div class="key-group">
            <div class="key-row">
              <span class="swatch" style={`background: ${item.color}`} aria-hidden="true" />
              <span class="key-copy">
                <span>{item.name}</span>
              </span>
            </div>
            {item.children.length > 0 && (
              <div class="key-children">
                {item.children.map((child) => (
                  <div class="key-row">
                    <span class="swatch" style={`background: ${child.color}`} aria-hidden="true" />
                    <span class="key-copy">
                      <span>{child.name}</span>
                    </span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </section>
  </aside>

  <section class="stage" aria-label="Inline Apollo Saturn V diagram">
    <div class="rocket-shell">
      <div class="mode-toggle" role="tablist" aria-label="Apollo diagram data mode">
        <button class="mode-button is-active" type="button" data-mode-button data-mode="contractors" aria-selected="true">Contractors</button>
        <button class="mode-button" type="button" data-mode-button data-mode="prices" aria-selected="false">Prices</button>
      </div>
      <div class="rocket-window">
        <article class="rocket-slide" aria-label={slide.label}>
          <span class="rocket-label">{slide.label}</span>
          <div set:html={slide.svg} />
        </article>
      </div>
    </div>
  </section>

  <div class="tooltip" data-tooltip aria-hidden="true">
    <strong data-tooltip-part></strong>
    <span data-tooltip-contractor></span>
    <span data-tooltip-price></span>
    <span data-tooltip-description></span>
  </div>
</section>
