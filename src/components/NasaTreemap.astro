<div id="barchart-root">

<header>
  <h1>NASA Corporate Contract Obligations by Recipient</h1>
  <p>Source: USAspending.gov</p>
</header>

<div id="treemap-controls">
  <div id="year-label">—</div>
  <button id="play-btn">▶ Play</button>
  <div id="slider-wrap">
    <input type="range" id="year-slider" min="0" step="1" value="0" />
    <div id="tick-labels"></div>
  </div>
</div>

<div id="chart-wrap">
  <svg id="treemap"></svg>
</div>

</div>

<style>
  #barchart-root {
    display: flex;
    flex-direction: column;
    height: 860px;
    background: var(--paper);
    font-family: var(--font);
  }

  header {
    padding: 20px 32px 12px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    flex-shrink: 0;
  }

  header h1 {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    max-width: none;
    line-height: 1.3;
  }

  header p {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 3px;
  }

  #treemap-controls {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 14px 32px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  #year-label {
    font-size: 2rem;
    font-weight: 700;
    color: var(--ink);
    min-width: 80px;
    text-align: center;
    line-height: 1.1;
  }

  #play-btn {
    background: var(--ink);
    border: none;
    color: #fff;
    padding: 7px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: background 0.2s;
    width: 90px;
    height: 34px;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #play-btn:hover { background: #333; }

  #slider-wrap {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #year-slider {
    -webkit-appearance: none;
    width: 100%;
    height: 5px;
    border-radius: 3px;
    background: var(--line);
    outline: none;
    cursor: pointer;
  }

  #year-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--ink);
    cursor: pointer;
    border: 2px solid var(--paper);
  }

  #tick-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    color: var(--muted);
    padding: 0 2px;
  }

  #chart-wrap {
    flex: 1;
    min-height: 0;
    padding: 0;
    position: relative;
    background: var(--paper);
  }

  #treemap {
    width: 100%;
    height: 100%;
    display: block;
    font-family: var(--font);
  }

  :global(#treemap .bar-name) {
    fill: #444;
    font-size: 12px;
    dominant-baseline: middle;
    text-anchor: end;
  }

  :global(#treemap .bar-value) {
    fill: #555;
    font-size: 14px;
    dominant-baseline: middle;
    font-weight: 500;
  }

  :global(#treemap .x-axis .tick text) {
    fill: #888;
    font-size: 10px;
  }

  :global(#treemap .x-axis .domain) { stroke: #ddd; }
  :global(#treemap .x-axis .tick line) { stroke: #ddd; }

  :global(#treemap .grid .tick line) {
    stroke: #e8e8e8;
    stroke-dasharray: 3 3;
  }

  :global(#treemap .grid .domain) { display: none; }
</style>

<script>
  import * as d3 from 'd3';

  const YEARS = [
    "2008","2009","2010","2011","2012","2013","2014","2015",
    "2016","2017","2018","2019","2020","2021","2022","2023",
    "2024","2025",
  ];

  const NAMED_COLORS: [RegExp, string][] = [
    [/north\s*american\s*aviation/i,                 "#8ad5f2"],
    [/douglas\s*aircraft/i,                          "#63c5ea"],
    [/lockheed\s*propulsion/i,                       "#7acb98"],
    [/lockheed/i,                                    "#16a35f"],
    [/aerojet\s*rocketdyne/i,                        "#e76f33"],
    [/rocketdyne/i,                                  "#f2a56e"],
    [/northrop\s*grumman/i,                          "#f5df2e"],
    [/boeing/i,                                      "#02a9df"],
    [/teledyne\s*brown/i,                            "#d82f84"],
    [/\bibm\b|international\s*business\s*machines/i, "#6a4cff"],
    [/spacex|space\s*exploration\s*technologies/i,   "#f00"],
  ];
  const GREY = "#5f6063";
  const topN = 12;
  const margin = { top: 52, right: 130, bottom: 38, left: 220 };
  const lineH = 14;
  const maxLabelChars = 22;

  function recipientColor(name: string) {
    for (const [re, color] of NAMED_COLORS) {
      if (re.test(name)) return color;
    }
    return GREY;
  }

  function fmt(n: number) {
    if (Math.abs(n) >= 1e9) return `$${(n / 1e9).toFixed(2)}B`;
    if (Math.abs(n) >= 1e6) return `$${(n / 1e6).toFixed(1)}M`;
    return `$${d3.format(",d")(n)}`;
  }

  function wrapName(name: string): string[] {
    const maxChars = maxLabelChars;
    const words = name.split(/\s+/);
    const lines: string[] = [];
    let cur = '';
    for (const w of words) {
      const test = cur ? cur + ' ' + w : w;
      if (test.length <= maxChars) {
        cur = test;
      } else {
        if (cur) lines.push(cur);
        cur = w.length > maxChars ? w.slice(0, maxChars - 1) + '…' : w;
      }
    }
    if (cur) lines.push(cur);
    return lines.slice(0, 3);
  }

  function getTopN(mapData: Map<string, number>, n: number) {
    return [...mapData.entries()]
      .filter(([name, v]) => v > 0 && !/university|universities|institute/i.test(name))
      .sort((a, b) => b[1] - a[1])
      .slice(0, n)
      .map(([name, value], rank) => ({ name, value, rank }));
  }

  let allData: Map<string, number>[] = [];
  let yearIdx = 0;
  let playing = false;
  let playTimer: ReturnType<typeof setTimeout> | null = null;
  let lastW = 0, lastH = 0;
  let globalMax = 0;
  let prevTotal = 0;

  let g: any, barsG: any, nameLabelsG: any, valueLabelsG: any, xAxisG: any, gridG: any;
  let totalValueEl: any = null;

  const slider = document.getElementById("year-slider") as HTMLInputElement;
  const yearLabel = document.getElementById("year-label")!;
  const playBtn = document.getElementById("play-btn")!;
  const chartWrap = document.getElementById("chart-wrap")!;
  const svg = d3.select<SVGSVGElement, unknown>("svg#treemap");

  const tickWrap = document.getElementById("tick-labels")!;
  YEARS.forEach(y => {
    const span = document.createElement("span");
    span.textContent = y;
    tickWrap.appendChild(span);
  });

  slider.max = String(YEARS.length - 1);
  slider.value = "0";

  function initChart(innerW: number, innerH: number) {
    svg.selectAll("*").remove();
    g = svg.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    g.append("text")
      .attr("x", innerW)
      .attr("y", -34)
      .attr("text-anchor", "end")
      .attr("fill", "#aaa")
      .attr("font-size", "9px")
      .attr("letter-spacing", "0.1em")
      .text("TOTAL NASA CONTRACTS");

    totalValueEl = g.append("text")
      .attr("x", innerW)
      .attr("y", -12)
      .attr("text-anchor", "end")
      .attr("fill", "#222")
      .attr("font-size", "22px")
      .attr("font-weight", "700");

    gridG       = g.append("g").attr("class", "grid").attr("transform", `translate(0,${innerH})`);
    barsG       = g.append("g").attr("class", "bars");
    nameLabelsG = g.append("g");
    valueLabelsG= g.append("g");
    xAxisG      = g.append("g").attr("class", "x-axis").attr("transform", `translate(0,${innerH})`);
  }

  function render(idx: number, animate = false) {
    yearIdx = idx;
    yearLabel.textContent = "FY" + YEARS[idx];
    slider.value = String(idx);

    const W = chartWrap.clientWidth || 800;
    const H = chartWrap.clientHeight || 560;
    const innerW = W - margin.left - margin.right;
    const innerH = H - margin.top - margin.bottom;

    if (W !== lastW || H !== lastH) {
      svg.attr("width", W).attr("height", H);
      initChart(innerW, innerH);
      lastW = W; lastH = H;
    }

    const items = getTopN(allData[idx], topN);
    const barSlotH = innerH / topN;
    const barH = Math.max(1, barSlotH - 5);

    // Fixed global scale — domain never changes after load
    const xScale = d3.scaleLinear().domain([0, globalMax]).range([0, innerW]);

    const dur = animate ? 700 : 0;
    const t = d3.transition().duration(dur).ease(d3.easeCubicInOut);

    // Animated total counter
    const grandTotal = [...allData[idx].values()].reduce((a, b) => a + b, 0);
    const fromTotal = prevTotal;
    if (totalValueEl) {
      totalValueEl.transition(t).tween("text", function(this: SVGTextElement) {
        const el = this;
        const interp = d3.interpolateNumber(fromTotal, grandTotal);
        return (frac: number) => { d3.select(el).text(fmt(interp(frac))); };
      });
    }
    prevTotal = grandTotal;

    // Grid lines
    gridG.transition(t).call(
      (d3.axisBottom(xScale).ticks(5).tickSize(-innerH).tickFormat(() => "")) as any
    );

    // X axis
    xAxisG.transition(t).call(
      (d3.axisBottom(xScale).ticks(5).tickFormat(d => fmt(d as number))) as any
    );
    xAxisG.select(".domain").attr("stroke", "#ddd");
    xAxisG.selectAll(".tick line").attr("stroke", "#ddd");
    xAxisG.selectAll(".tick text").style("fill", "#888").style("font-size", "10px");

    // Bars
    const bars = barsG.selectAll(".bar").data(items, (d: any) => d.name);

    bars.enter().append("rect").attr("class", "bar")
      .attr("x", 0).attr("y", innerH).attr("height", barH).attr("width", 0)
      .attr("fill", (d: any) => recipientColor(d.name)).attr("opacity", 0);

    barsG.selectAll(".bar").transition(t)
      .attr("y", (d: any) => d.rank * barSlotH)
      .attr("height", barH)
      .attr("width", (d: any) => Math.max(0, xScale(d.value)))
      .attr("fill", (d: any) => recipientColor(d.name))
      .attr("opacity", 0.88);

    bars.exit().transition(t).attr("y", innerH).attr("opacity", 0).remove();

    // Name labels with multi-line wrapping — uniform color via CSS
    const names = nameLabelsG.selectAll(".bar-name").data(items, (d: any) => d.name);

    const namesEnter = names.enter().append("text").attr("class", "bar-name")
      .attr("x", -22)
      .attr("y", innerH)
      .attr("font-weight", (d: any) => recipientColor(d.name) !== GREY ? "700" : "400")
      .attr("opacity", 0);

    // Tspans set once on enter; name never changes for a given company key
    namesEnter.each(function(this: SVGTextElement, d: any) {
      const lines = wrapName(d.name);
      const el = d3.select(this);
      lines.forEach((line, i) => {
        el.append("tspan")
          .attr("x", -22)
          .attr("dy", i === 0 ? -(lines.length - 1) * lineH / 2 : lineH)
          .text(line);
      });
    });

    nameLabelsG.selectAll(".bar-name").transition(t)
      .attr("y", (d: any) => d.rank * barSlotH + barH / 2)
      .attr("opacity", 1);

    names.exit().transition(t).attr("y", innerH).attr("opacity", 0).remove();

    // Value labels — uniform color via CSS
    const vals = valueLabelsG.selectAll(".bar-value").data(items, (d: any) => d.name);

    vals.enter().append("text").attr("class", "bar-value")
      .attr("x", 0).attr("y", innerH).attr("opacity", 0);

    valueLabelsG.selectAll(".bar-value").transition(t)
      .attr("x", (d: any) => Math.max(0, xScale(d.value)) + 8)
      .attr("y", (d: any) => d.rank * barSlotH + barH / 2)
      .attr("opacity", 1)
      .text((d: any) => fmt(d.value));

    vals.exit().transition(t).attr("opacity", 0).remove();
  }

  slider.addEventListener("input", () => {
    stopPlay();
    if (allData[+slider.value]) render(+slider.value, true);
  });

  playBtn.addEventListener("click", () => {
    if (playing) stopPlay(); else startPlay();
  });

  function startPlay() {
    playing = true;
    playBtn.textContent = "⏸ Pause";
    if (yearIdx >= YEARS.length - 1) yearIdx = 0;
    step();
  }

  function stopPlay() {
    playing = false;
    playBtn.textContent = "▶ Play";
    if (playTimer) clearTimeout(playTimer);
  }

  function step() {
    if (!playing) return;
    render(yearIdx, true);
    if (yearIdx < YEARS.length - 1) {
      yearIdx++;
      playTimer = setTimeout(step, 900);
    } else {
      stopPlay();
    }
  }

  window.addEventListener("resize", () => {
    if (allData[yearIdx]) render(yearIdx, false);
  });

  async function loadAll() {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const json: Record<string, Record<string, number>> = await fetch(`${base}/nasa_contracts_aggregated.json`).then(r => r.json());
    allData = YEARS.map(y => new Map(Object.entries(json[y] ?? {})));

    // Compute global max across all years so x scale never changes
    globalMax = 0;
    allData.forEach(map => {
      const top = getTopN(map, 1);
      if (top.length > 0) globalMax = Math.max(globalMax, top[0].value);
    });

    render(0);
  }

  loadAll();
</script>
