---
import { rockets, renderRocketSvg } from '../lib/rocket';

const falconRocket = rockets.find((r) => r.slug === 'falcon')!;
const slide = { label: falconRocket.label, svg: renderRocketSvg(falconRocket) };
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const spacexLogoSrc = `${basePath}/rockets/falcon/spacex-logo-black.svg`;
---

<style is:global>
  .inline-diagram--falcon { min-height: 650px; }

  .inline-diagram--falcon .panel {
    width: 160px;
    padding: 0 6px 88px 0;
    transform: translateX(calc(-50% - 186px));
  }

  .inline-diagram--falcon .rocket-svg {
    width: min(100%, 230px);
    height: 620px;
  }

  .inline-diagram--falcon .spacex-logo {
    display: block;
    width: 150px;
    max-width: 100%;
    height: auto;
  }

  .inline-diagram--falcon .key-copy span {
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.25;
  }

  @media (max-width: 780px) {
    .inline-diagram--falcon .rocket-svg { height: auto; }
  }
</style>

<section
  class="inline-diagram inline-diagram--falcon diagram-panel"
  data-diagram-panel
  data-initial-mode="contractors"
  data-no-prices="true"
  aria-label="Falcon 9 vertical integration diagram"
>
  <aside class="panel" aria-label="Falcon 9 vertical integration key">
    <section class="key contractor-key" aria-labelledby="inline-falcon-title">
      <h2 id="inline-falcon-title">Key</h2>
      <div class="key-group">
        <div class="key-row">
          <span class="swatch" style="background: #d71920" aria-hidden="true" />
          <span class="key-copy">
            <img
              class="spacex-logo"
              src={spacexLogoSrc}
              alt="SpaceX"
              loading="eager"
              decoding="async"
            />
          </span>
        </div>
      </div>
    </section>
  </aside>

  <section class="stage" aria-label="Inline Falcon 9 vertical integration diagram">
    <div class="rocket-shell">
      <div class="rocket-window">
        <article class="rocket-slide" aria-label={slide.label}>
          <span class="rocket-label">{slide.label}</span>
          <div set:html={slide.svg} />
        </article>
      </div>
    </div>
  </section>

  <div class="tooltip" data-tooltip aria-hidden="true">
    <strong data-tooltip-part></strong>
    <span data-tooltip-contractor></span>
    <span data-tooltip-price></span>
    <span data-tooltip-description></span>
  </div>
</section>
